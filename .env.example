# Основная версия PHP (для just host по умолчанию)
DEFAULT_PHP_VERSION=8.2
HOST_ZONE=dvl.to

# Контейнерный движок для justfile: podman | docker (пусто — автоопределение)
ENGINE=

# Compose: основной файл + автогенерируемые алиасы *.dvl.to
COMPOSE_FILE=docker-compose.yaml:docker-compose.aliases.yaml

# Порты на хосте (менять при конфликтах)
HTTP_PORT=80
HTTPS_PORT=443
MYSQL_PORT=3306
PG_PORT=5432
REDIS_PORT=6379
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
PMA_PORT=8080
ADMINER_PORT=8081
PANEL_PORT=8989

# Пароли
MYSQL_ROOT_PASSWORD=root
POSTGRES_PASSWORD=root

# Xdebug: off | debug | develop | profile ...
XDEBUG_MODE=off
